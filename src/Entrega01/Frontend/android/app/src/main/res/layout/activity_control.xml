<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SmartTennis.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/controle_manual">

        <TextView
            android:id="@+id/status_conexao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="● Conectado"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movimento"
                android:textAppearance="@style/TextAppearance.SmartTennis.Title"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_servo_esq"
                            style="@style/Widget.SmartTennis.Button.Accent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/servo_esq" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_servo_dir"
                            style="@style/Widget.SmartTennis.Button.Accent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/servo_dir" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_servo_cima"
                            style="@style/Widget.SmartTennis.Button.Accent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/servo_cima" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_servo_baixo"
                            style="@style/Widget.SmartTennis.Button.Accent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/servo_baixo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/atuadores"
                android:textAppearance="@style/TextAppearance.SmartTennis.Title"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_laser"
                            style="@style/Widget.SmartTennis.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/laser"
                            app:icon="@drawable/ic_laser" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_led"
                            style="@style/Widget.SmartTennis.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/led" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_buzzer"
                            style="@style/Widget.SmartTennis.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/buzzer"
                            app:icon="@drawable/ic_buzzer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset"
                            style="@style/Widget.SmartTennis.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:text="@string/reset_servos" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/sessao"
                android:textAppearance="@style/TextAppearance.SmartTennis.Title"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_iniciar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/iniciar"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pausar"
                    style="@style/Widget.SmartTennis.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/pausar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- E-STOP fixo: precisa estar SEMPRE visível, sem rolar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_estop"
        style="@style/Widget.SmartTennis.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginVertical="@dimen/spacing_sm"
        android:text="@string/estop"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log"
            android:textAppearance="@style/TextAppearance.SmartTennis.Title"
            android:textSize="14sp" />

        <ListView
            android:id="@+id/log_list"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_limpar"
            style="@style/Widget.SmartTennis.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/limpar_logs" />
    </LinearLayout>
</LinearLayout>
