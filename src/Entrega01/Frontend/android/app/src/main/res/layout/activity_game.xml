<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        style="@style/Widget.SmartTennis.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name">

        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="⏱ 01:00"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/nivel_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SmartTennis.Caption" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_secondary"
            app:cardCornerRadius="@dimen/radius_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/score_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pts"
                    android:textColor="@color/md_theme_on_background"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/acertos_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acertos: 0"
                    android:textColor="@color/md_theme_on_background"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/tempo_restante"
            android:textAppearance="@style/TextAppearance.SmartTennis.Caption" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/tempo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:max="60"
            android:progress="60"
            app:indicatorColor="@color/md_theme_primary"
            app:trackColor="@color/md_theme_surface_variant"
            app:trackCornerRadius="6dp"
            app:trackThickness="12dp" />

        <!-- Feedback de acerto (aparece e some) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_sm">

            <TextView
                android:id="@+id/acerto_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_flash_acerto"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="ACERTO!  +10 pts ✓"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Direcional do laser -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cima"
                style="@style/Widget.SmartTennis.Button.Accent"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_esq"
                    style="@style/Widget.SmartTennis.Button.Accent"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="◀"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dir"
                    style="@style/Widget.SmartTennis.Button.Accent"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="▶"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_baixo"
                style="@style/Widget.SmartTennis.Button.Accent"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ligar_laser"
                style="@style/Widget.SmartTennis.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/ligar_laser"
                android:textSize="12sp"
                app:icon="@drawable/ic_laser" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desligar_laser"
                style="@style/Widget.SmartTennis.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/desligar_laser"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finalizar"
            style="@style/Widget.SmartTennis.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/parar_jogo"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
